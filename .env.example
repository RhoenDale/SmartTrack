# Public PHP API URL used by the GitHub Pages build.
# Leave unset for local npm run dev; Vite uses the XAMPP proxy automatically.
VITE_API_URL=https://your-api-domain.example/SmartTrack/api

# Local XAMPP Apache URL used by the Vite dev proxy (Windows and macOS).
# Default: http://127.0.0.1:80
# Set this if Apache uses another port, for example:
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080
